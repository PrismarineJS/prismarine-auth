{
  "name": "prismarine-auth",
  "version": "3.1.1",
  "description": "Authentication library for Microsoft, Xbox Live, and Minecraft with caching support",
  "main": "index.js",
  "scripts": {
    "mocha": "mocha test/*.test.js --reporter spec --exit",
    "test": "npm run mocha",
    "pretest": "npm run lint && npm run typecheck",
    "lint": "standard",
    "fix": "standard --fix",
    "typecheck": "tsc --noEmit --strict --skipLibCheck --target ES2020 --module commonjs test/types/xsapi.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrismarineJS/prismarine-auth.git"
  },
  "keywords": [
    "prismarine",
    "template"
  ],
  "author": "Romain Beaumont",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/PrismarineJS/prismarine-auth/issues"
  },
  "homepage": "https://github.com/PrismarineJS/prismarine-auth#readme",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "chai": "^4.3.4",
    "chai-as-promised": "^7.1.1",
    "mocha": "^11.0.1",
    "prismarine-auth": "file:.",
    "standard": "^17.0.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@azure/msal-node": "^2.0.2",
    "@xboxreplay/xboxlive-auth": "^5.1.0",
    "debug": "^4.3.3",
    "json-bigint": "^1.0.0",
    "smart-buffer": "^4.1.0",
    "uuid-1345": "^1.0.2",
    "xbox-rta": "github:extremeheat/xbox-rta#153175046e8798df396661b216c51f6ff8c0cdcd"
  }
}
